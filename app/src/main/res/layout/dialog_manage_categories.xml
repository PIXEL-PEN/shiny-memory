<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Action -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/mc_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- From -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/from"
            android:paddingTop="12dp" />

        <Spinner
            android:id="@+id/mc_from"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Target -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/target"
            android:paddingTop="12dp" />

        <Spinner
            android:id="@+id/mc_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- New name -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/new_name"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/mc_new_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/new_name_hint" />

        <!-- Force move -->
        <CheckBox
            android:id="@+id/mc_force_uncategorized"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/force_move_uncategorized"
            android:paddingTop="12dp"
            android:visibility="gone" />

        <!-- Preview output -->
        <TextView
            android:id="@+id/mc_preview_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
