<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/folder_browser_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Static header row: fully decoupled, big tap target -->
    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/black"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:orientation="horizontal">

        <!-- Click target spans arrow + title -->
        <LinearLayout
            android:id="@+id/header_click_target"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back_white_24dp" />

            <!-- Breadcrumb chevron to match Markor’s “ > ” cue -->
            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="› Browser Tree"
                android:textColor="@android:color/white"
                android:textSize="23sp"
                android:textStyle="bold"
                android:paddingStart="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <WebView
        android:id="@+id/folder_browser_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>
