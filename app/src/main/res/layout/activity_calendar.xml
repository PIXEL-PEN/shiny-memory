<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context=".activity.CalendarActivity">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/black"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/header_click_target"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back_white_24dp" />

            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="› Calendar"
                android:textColor="@android:color/white"
                android:textSize="23sp"
                android:textStyle="bold"
                android:paddingStart="4dp"/>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_manage_categories_toolbar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/manage_categories"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/calendar_grid_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F2F2F2">

            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height=".9dp"
            android:layout_gravity="bottom"
            android:background="#222222" />

        <!-- Browser icon row (lowered slightly toward the spinner) -->
        <LinearLayout
            android:id="@+id/browser_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="0dp">

            <ImageButton
                android:id="@+id/btn_browser"
                android:layout_width="63dp"
                android:layout_height="63dp"
                android:src="@drawable/ic_folder_outline_black_24dp"
                android:scaleType="centerInside"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="Browse"
                android:layout_marginEnd="4dp"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- Button + Spinner row -->
        <LinearLayout
            android:id="@+id/button_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="100">

            <Button
                android:id="@+id/btn_reset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="22"
                android:text="Reset"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/btn_reset_style" />

            <Button
                android:id="@+id/btn_submit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="22"
                android:text="Submit"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/btn_submit_style" />

            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="56"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/input_note_title"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:hint="Enter note title.."
            android:textColorHint="@android:color/darker_gray"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="250"
            android:maxLines="10"
            android:gravity="top|start"
            android:background="@drawable/bg_edittext_amber"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:scrollHorizontally="false" />

    </LinearLayout>
</LinearLayout>
