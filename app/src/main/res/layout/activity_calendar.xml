<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calendar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    tools:context=".activity.CalendarActivity">

    <!-- Top toolbar -->
    <include layout="@layout/include_markor_toolbar" />

    <!-- Content wrapper (gives padding to content, not toolbar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Calendar Grid with native CalendarView -->
        <FrameLayout
            android:id="@+id/calendar_grid_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F2F2F2"> <!-- Light gray, slightly darker -->

            <CalendarView
                android:id="@+id/calendarView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height=".9dp"
                android:layout_gravity="bottom"
                android:background="#222222" /> <!-- Near black -->
        </FrameLayout>




        <!-- Browser icon row -->
        <LinearLayout
            android:id="@+id/browser_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <ImageButton
                android:id="@+id/btn_browser"
                android:layout_width="63dp"
                android:layout_height="63dp"
                android:src="@drawable/ic_folder_outline_black_24dp"
                android:scaleType="centerInside"
                android:background="?android:selectableItemBackgroundBorderless"
                android:contentDescription="Browse"
                android:layout_marginEnd="4dp"
                android:layout_gravity="center_vertical" />



        </LinearLayout>

        <!-- Button + Spinner row -->
        <LinearLayout
            android:id="@+id/button_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="100">

            <!-- Reset (compact) -->
            <Button
                android:id="@+id/btn_reset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="22"
                android:text="Reset"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/btn_reset_style" />

            <!-- Submit (compact) -->
            <Button
                android:id="@+id/btn_submit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="22"
                android:text="Submit"
                android:textAllCaps="false"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/btn_submit_style" />


            <Spinner
                android:id="@+id/spinner_category"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="56"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp" />
        </LinearLayout>

        <!-- Input Field with fixed height and scroll -->
        <EditText
            android:id="@+id/input_note_title"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:hint="Enter note title.."
            android:textColorHint="@android:color/darker_gray"
            android:inputType="textMultiLine"
            android:maxLength="250"
            android:maxLines="10"
            android:gravity="top|start"
            android:background="@drawable/bg_edittext_amber"


            android:padding="8dp"
            android:scrollbars="vertical"
            android:overScrollMode="always"
            android:scrollHorizontally="false" />

    </LinearLayout>
</LinearLayout>
